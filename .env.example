# ============================================================
# 研途智探AI · 网页版环境变量模板
# 复制为 .env 后填写真实值：cp .env.example .env
# 默认端口：前端 3001 / 后端 8000 / 学术MCP 7001
# ============================================================

# ---- LLM (DeepSeek, OpenAI 兼容) ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 当前可用：deepseek-v4-pro（主，推理）/ deepseek-v4-flash（快档）
# 旧别名 deepseek-chat / deepseek-reasoner 仍可作覆盖项
MAIN_MODEL=deepseek-v4-pro
SUMMARY_MODEL=deepseek-v4-flash

# ---- 智谱（web_search 可选）----
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# ---- 学术数据源（均免费，无需 Key；mailto 走礼貌池）----
ACADEMIC_MAILTO=yanjiu@research-quest.cn
# 留空则默认三源全用；填 crossref / openalex / s2 可单源测试
ACADEMIC_PRIMARY=crossref

# ---- 学术 MCP ----
MCP_HOST=127.0.0.1
MCP_PORT=7001
MCP_PATH=/mcp
MCP_ACADEMIC_URL=http://127.0.0.1:7001/mcp
MCP_API_KEY=

# ---- Auth ----
APP_ENV=development
AUTH_ENABLED=true
# 生产必须改为强随机值（>=32字节）。生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-please-generate-a-strong-random-secret-here
FAIL_ON_INSECURE_CONFIG=false
# 生产强烈建议设为 true：弱配置直接拒启而非仅告警
# 访问令牌有效期（曾默认 72h 偏长，建议 8-24）
JWT_EXPIRE_HOURS=24
# 强烈建议用 bcrypt 哈希密码：python -c "import bcrypt;print('bcrypt\$'+bcrypt.hashpw(b'你的密码',bcrypt.gensalt()).decode())"
# 下方为占位示例（上线前请改密码并重新生成哈希）
AUTH_USERS=[{"user_id":"yanjiu","username":"yanjiu","password":"bcrypt$REPLACE_WITH_BCRYPT_HASH","roles":["admin"]}]
DEFAULT_USER_ID=yanjiu
DEFAULT_USERNAME=yanjiu

# ---- 容错 / 运行时 ----
ALLOW_DEGRADED_START=true
REQUIRE_MCP=false
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
AUDIT_LOG_ENABLED=true
LOG_LEVEL=INFO

# ---- 限流 / 安全头 ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_REQUESTS=180
LOGIN_RATE_LIMIT_MAX=10
SECURITY_HEADERS_ENABLED=true

# ---- 端口 ----
BACKEND_PORT=8000
FRONTEND_PORT=3001
MCP_PORT_FROM_ENV=7001
API_TITLE=研途智探AI 科研导师 API
API_VERSION=1.0.0
